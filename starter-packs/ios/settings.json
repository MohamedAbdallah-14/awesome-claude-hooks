{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/security/block-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/security/protect-dotenv.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/security/block-dangerous-bash.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/security/audit-bash-commands.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/git/protect-main-branch.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/security/block-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/quality/validate-json-yaml.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/security/audit-file-writes.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/context/inject-recent-commits.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/session/context-threshold-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/notifications/desktop-notify.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/session/session-summary.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/context/inject-git-context.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/awesome-hooks/hooks/cost/log-tool-usage.sh"
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/security/block-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/security/protect-dotenv.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/security/block-dangerous-bash.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/git/conflict-detector.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/git/protect-main-branch.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/security/block-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/quality/validate-json-yaml.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/security/block-secrets.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/quality/prettier-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/quality/eslint-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/quality/tsc-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/context/inject-recent-commits.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/notifications/macos-notify.sh || bash ~/.claude/hooks/hooks/notifications/linux-notify.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/notifications/terminal-title.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/context/inject-git-context.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hooks/fun/session-stats.sh"
          }
        ]
      }
    ]
  }
}

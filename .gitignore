# Test artifacts written to the repo root (all test output should go to /tmp)
/tmp/

# Installer-generated backups (these belong next to the real settings.json,
# which is outside this repo — but guard against accidental copies here)
settings.json.backup
*.backup

# Hook run logs that someone might accidentally write inside the repo
*.log
/logs/

# macOS extended attribute junk that leaks into zips
__MACOSX/
AGENTS.md

# docs-site/ fetches its own copy of the registry; it's generated at deploy
# time (and by `make pages-serve` locally), so don't commit it.
docs-site/registry.json
